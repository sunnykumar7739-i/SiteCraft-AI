# ---------- AI (at least one; otherwise an offline mock generator is used) ----------
AI_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5  # any current Claude model id
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---------- Supabase (optional; leave empty for local demo mode) ----------
# Create a project at https://supabase.com, run supabase/schema.sql, enable
# Google/GitHub providers under Authentication → Providers, and set
# Site URL + Redirect URL to http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Billing (optional) ----------
STRIPE_SECRET_KEY=
