# ================= AI (at least one; otherwise an offline mock generator is used) =================
AI_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5  # any current Claude model id
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ================= DATABASE =================
# Default (no config): SQLite file at ./data/sitecraft.db — real SQL DB, zero setup, great for local & single-server.
# Production: Supabase (Postgres + Auth + Storage). Create a project at https://supabase.com,
#   run supabase/schema.sql in the SQL editor, enable Google/GitHub under Authentication → Providers,
#   and add http://localhost:3000/auth/callback (and your domain) as redirect URLs.
# DB_DRIVER=sqlite                  # force: supabase | sqlite | json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# ================= PAYMENTS (optional; without keys, plan changes are instant in dev) =================
# PAYMENT_PROVIDER=razorpay         # razorpay | stripe (auto-detected from keys if unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # Dashboard → Webhooks → URL: https://yourdomain.com/api/billing/webhook/razorpay (events: payment.captured)
USD_INR_RATE=85                     # plan prices are in USD; Razorpay charges INR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # Dashboard → Webhooks → URL: https://yourdomain.com/api/billing/webhook/stripe (event: checkout.session.completed)
